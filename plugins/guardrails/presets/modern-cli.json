{
  "description": "Nudge toward fd over find, rg over grep -r, cargo nextest over cargo test and dust over du when they are installed (fd may be named fdfind), with a one-line warning shown once per session.",
  "rules": {
    "find-fd": {
      "description": "find when fd is installed",
      "match": {"command": "find", "not": {"via": "ssh"}},
      "when": {
        "bin": [
          "fd",
          "fdfind"
        ]
      },
      "action": "warn",
      "message": "Prefer `{found}` over `find` (faster, respects .gitignore); see `{found} --help`. It skips hidden and ignored files unless you pass `-u`."
    },
    "grep-rg": {
      "description": "recursive grep when ripgrep is installed",
      "match": {
        "all": [
          {"command": ["grep", "egrep", "fgrep"]},
          {
            "any": [
              {"flag": ["r", "R", "recursive", "dereference-recursive"]},
              {
                "flag": ["d", "directories"],
                "has": {"pattern": {"context": "\"$a\" recurse", "selector": "word"}}
              }
            ]
          },
          {"not": {"via": "ssh"}}
        ]
      },
      "when": {
        "bin": "rg"
      },
      "action": "warn",
      "message": "Prefer `rg` over recursive grep (faster, respects .gitignore); see `rg --help`. It skips hidden and ignored files unless you pass `-uu`."
    },
    "cargo-nextest": {
      "description": "cargo test when cargo-nextest is installed (doctests exempt)",
      "match": {
        "command": "cargo",
        "has": {
          "pattern": {"context": "\"$a\" test", "selector": "word"},
          "not": {"follows": {"matcher": "preset.operand", "stopBy": "end"}}
        },
        "not": {"flag": "doc"},
        "all": [{"not": {"via": "ssh"}}]
      },
      "when": {
        "bin": "cargo-nextest"
      },
      "action": "warn",
      "message": "Prefer `cargo nextest run` over `cargo test` (faster, one process per test; `--nocapture` is `--no-capture`); see `cargo nextest run --help`. Doctests still need `cargo test --doc`."
    },
    "du-dust": {
      "description": "du when dust is installed",
      "match": {
        "any": [
          {"command": "du", "has": {"capture": {"matcher": "preset.operand"}, "name": "PATH"}},
          {"command": "du"}
        ],
        "not": {"via": "ssh"}
      },
      "when": {
        "bin": "dust"
      },
      "action": "warn",
      "message": "Prefer `dust` over `du` (sorted, with bars): `dust -d 1` for one level; see `dust --help`.",
      "messages": [
        {
          "when": {"matches": {"has": {"matcher": "preset.operand"}}},
          "text": "Prefer `dust` over `du` (sorted, with bars): `dust -d 1 {PATH}` for one level; see `dust --help`."
        }
      ]
    }
  },
  "matchers": {
    "preset.operand": {"kind": "word", "regex": "^[^-+]"}
  },
  "modes": {},
  "examples": {
    "find-fd": {
      "catch": [
        "find . -name x",
        "sudo find /tmp -type f",
        "find . -exec rm {} \\;",
        "cd src && find . -name '*.rs'"
      ],
      "pass": [
        "fd x",
        "echo find",
        "ls -la",
        "man find",
        "ssh host find . -name x"
      ]
    },
    "grep-rg": {
      "catch": [
        "grep -r x .",
        "egrep -R y src",
        "grep -d recurse z .",
        "sudo grep -rn x /var/log"
      ],
      "pass": [
        "rg x",
        "grep x file",
        "grep -- -r file",
        "echo grep -r",
        "ssh host grep -r x ."
      ]
    },
    "cargo-nextest": {
      "catch": [
        "cargo test",
        "cargo test --workspace",
        "cargo test -p foo my_test -- --nocapture",
        "cd crates/x && cargo test",
        "RUST_BACKTRACE=1 cargo +nightly test",
        "sudo cargo test -q",
        "cargo test 2>&1 | tail -20",
        "cargo +stable test",
        "cargo -q test -p x",
        "cargo --locked test",
        ">/dev/null cargo test"
      ],
      "pass": [
        "cargo test --doc",
        "cargo test --workspace --doc -p foo",
        "cargo nextest run",
        "cargo nextest run test",
        "cargo build --features test",
        "echo cargo test",
        "man cargo-test",
        "ssh host cargo test",
        "cargo new test",
        "cargo build --locked --features test"
      ]
    },
    "du-dust": {
      "catch": [
        "du -sh .",
        "du -h --max-depth=1 /var",
        "sudo du -sk /Users",
        "du -sh * | sort -h",
        "du -d 1 ~"
      ],
      "pass": [
        "dust -d 1 .",
        "df -h",
        "echo du",
        "man du",
        "duplicity status",
        "ssh host du -sh /var"
      ]
    }
  }
}
