{
  "description": "Nudge toward fd over find, rg over grep -r, cargo nextest over cargo test and dust over du when they are installed (fd may be named fdfind), with a one-line warning shown once per session.",
  "rules": {
    "find-fd": {
      "description": "find when fd is installed",
      "match": {
        "command": "find"
      },
      "when": {
        "bin": [
          "fd",
          "fdfind"
        ]
      },
      "action": "warn",
      "message": "Prefer `{found}` over `find` (faster, respects .gitignore); see `{found} --help`. It skips hidden and ignored files unless you pass `-u`."
    },
    "grep-rg": {
      "description": "recursive grep when ripgrep is installed",
      "match": {
        "all": [
          {
            "command": [
              "grep",
              "egrep",
              "fgrep"
            ]
          },
          {
            "any": [
              {
                "has": {
                  "regex": "^(?:-[A-Za-z&&[^efmABCdD]]*[rR][A-Za-z]*|-drecurse|--recursive|--dereference-recursive|--directories=recurse)$",
                  "not": {
                    "follows": {
                      "regex": "^--$",
                      "stopBy": {
                        "regex": "^[\"']?(?:[^\\s]*/)?(?:grep|egrep|fgrep)[\"']?$"
                      }
                    }
                  },
                  "follows": {
                    "regex": "^[\"']?(?:[^\\s]*/)?(?:grep|egrep|fgrep)[\"']?$",
                    "stopBy": "end"
                  }
                }
              },
              {
                "has": {
                  "regex": "^(?:-d|--directories)$",
                  "precedes": {
                    "regex": "^recurse$"
                  },
                  "not": {
                    "follows": {
                      "regex": "^--$",
                      "stopBy": {
                        "regex": "^[\"']?(?:[^\\s]*/)?(?:grep|egrep|fgrep)[\"']?$"
                      }
                    }
                  },
                  "follows": {
                    "regex": "^[\"']?(?:[^\\s]*/)?(?:grep|egrep|fgrep)[\"']?$",
                    "stopBy": "end"
                  }
                }
              }
            ]
          }
        ]
      },
      "when": {
        "bin": "rg"
      },
      "action": "warn",
      "message": "Prefer `rg` over recursive grep (faster, respects .gitignore); see `rg --help`. It skips hidden and ignored files unless you pass `-uu`."
    },
    "cargo-nextest": {
      "description": "cargo test when cargo-nextest is installed (doctests exempt)",
      "match": {
        "command": "cargo",
        "args": "(^|\\s)(\\S*/)?cargo(\\s+(\\+\\S+|--?(locked|offline|frozen|q|quiet|v|vv|verbose)))*\\s+test(\\s|$)",
        "not": {
          "has": {
            "regex": "^--doc$"
          }
        }
      },
      "when": {
        "bin": "cargo-nextest"
      },
      "action": "warn",
      "message": "Prefer `cargo nextest run` over `cargo test` (faster, one process per test); see `cargo nextest run --help`. Doctests still need `cargo test --doc`."
    },
    "du-dust": {
      "description": "du when dust is installed",
      "match": {
        "any": [
          {
            "command": "du",
            "has": {
              "capture": {
                "kind": "word",
                "regex": "^[^-]",
                "not": {
                  "regex": "^[0-9]+[KMGTB]?$"
                }
              },
              "name": "PATH"
            }
          },
          {
            "command": "du"
          }
        ]
      },
      "when": {
        "bin": "dust"
      },
      "action": "warn",
      "message": "Prefer `dust` over `du` (sorted, with bars): `dust -d 1` for one level; see `dust --help`.",
      "messages": [
        {
          "when": {
            "matches": {
              "has": {
                "kind": "word",
                "regex": "^[^-]",
                "not": {
                  "regex": "^[0-9]+[KMGTB]?$"
                }
              }
            }
          },
          "text": "Prefer `dust` over `du` (sorted, with bars): `dust -d 1 {PATH}` for one level; see `dust --help`."
        }
      ]
    }
  },
  "modes": {},
  "examples": {
    "find-fd": {
      "catch": [
        "find . -name x",
        "sudo find /tmp -type f",
        "find . -exec rm {} \\;",
        "cd src && find . -name '*.rs'"
      ],
      "pass": [
        "fd x",
        "echo find",
        "ls -la",
        "man find"
      ]
    },
    "grep-rg": {
      "catch": [
        "grep -r x .",
        "egrep -R y src",
        "grep -d recurse z .",
        "sudo grep -rn x /var/log"
      ],
      "pass": [
        "rg x",
        "grep x file",
        "grep -- -r file",
        "echo grep -r"
      ]
    },
    "cargo-nextest": {
      "catch": [
        "cargo test",
        "cargo test --workspace",
        "cargo test -p foo my_test -- --nocapture",
        "cd crates/x && cargo test",
        "RUST_BACKTRACE=1 cargo +nightly test",
        "sudo cargo test -q",
        "cargo test 2>&1 | tail -20"
      ],
      "pass": [
        "cargo test --doc",
        "cargo test --workspace --doc -p foo",
        "cargo nextest run",
        "cargo nextest run test",
        "cargo build --features test",
        "echo cargo test",
        "man cargo-test"
      ]
    },
    "du-dust": {
      "catch": [
        "du -sh .",
        "du -h --max-depth=1 /var",
        "sudo du -sk /Users",
        "du -sh * | sort -h",
        "du -d 1 ~"
      ],
      "pass": [
        "dust -d 1 .",
        "df -h",
        "echo du",
        "man du",
        "duplicity status"
      ]
    }
  }
}
