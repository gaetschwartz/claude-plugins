{
  "description": "Mistakes agents repeat with shell pipelines",
  "rules": {
    "pipe-status": {
      "description": "A pipeline ending in a filter whose status is read as if it were the producer's",
      "match": {
        "capture": {
          "command": [
            "head",
            "tail",
            "cat",
            "wc",
            "sort",
            "cut",
            "uniq",
            "tr",
            "sed",
            "tee",
            "column",
            "nl",
            "paste",
            "rev",
            "fold",
            "less",
            "more"
          ],
          "nthChild": {
            "position": 1,
            "reverse": true
          },
          "all": [
            {
              "inside": {
                "kind": "pipeline"
              }
            },
            {
              "inside": {
                "statement": {
                  "kind": "pipeline",
                  "any": [
                    {
                      "all": [
                        {
                          "not": {
                            "inside": {
                              "kind": "pipeline",
                              "stopBy": {
                                "not": {
                                  "kind": "list"
                                }
                              }
                            }
                          }
                        },
                        {
                          "not": {
                            "has": {
                              "kind": "command",
                              "nthChild": 1,
                              "any": [
                                {
                                  "has": {
                                    "field": "name",
                                    "regex": "^(\\S*/)?(echo|printf|ls|cat|pwd|date|ps|du|df)$"
                                  }
                                },
                                {
                                  "has": {
                                    "field": "name",
                                    "regex": "^git$"
                                  },
                                  "regex": "^git(\\s+-\\S+(\\s+\\S+)?)*\\s+(log|show|status|diff|branch|remote|ls-files|rev-parse|describe|shortlog|blame)(\\s|$)"
                                }
                              ]
                            }
                          }
                        }
                      ]
                    },
                    {
                      "inside": {
                        "kind": "pipeline",
                        "stopBy": {
                          "not": {
                            "kind": "list"
                          }
                        },
                        "not": {
                          "has": {
                            "kind": "command",
                            "nthChild": 1,
                            "any": [
                              {
                                "has": {
                                  "field": "name",
                                  "regex": "^(\\S*/)?(echo|printf|ls|cat|pwd|date|ps|du|df)$"
                                }
                              },
                              {
                                "has": {
                                  "field": "name",
                                  "regex": "^git$"
                                },
                                "regex": "^git(\\s+-\\S+(\\s+\\S+)?)*\\s+(log|show|status|diff|branch|remote|ls-files|rev-parse|describe|shortlog|blame)(\\s|$)"
                              }
                            ]
                          }
                        }
                      }
                    }
                  ]
                },
                "stopBy": {
                  "statement": {
                    "kind": "pipeline"
                  }
                },
                "all": [
                  {
                    "any": [
                      {
                        "precedes": {
                          "regex": "^(&&|\\|\\|)$"
                        }
                      },
                      {
                        "inside": {
                          "kind": "list",
                          "precedes": {
                            "regex": "^(&&|\\|\\|)$"
                          }
                        }
                      },
                      {
                        "inside": {
                          "any": [
                            {
                              "kind": "if_statement"
                            },
                            {
                              "kind": "while_statement"
                            }
                          ],
                          "field": "condition"
                        }
                      },
                      {
                        "nthChild": 1,
                        "inside": {
                          "kind": "elif_clause"
                        }
                      },
                      {
                        "precedes": {
                          "has": {
                            "kind": "special_variable_name",
                            "regex": "^\\?$",
                            "stopBy": "end"
                          },
                          "stopBy": "end"
                        }
                      },
                      {
                        "nthChild": {
                          "position": 1,
                          "reverse": true
                        },
                        "inside": {
                          "any": [
                            {
                              "kind": "subshell"
                            },
                            {
                              "kind": "compound_statement"
                            }
                          ],
                          "precedes": {
                            "regex": "^(&&|\\|\\|)$"
                          }
                        }
                      },
                      {
                        "has": {
                          "kind": "negated_command"
                        }
                      },
                      {
                        "has": {
                          "kind": "pipeline",
                          "has": {
                            "kind": "negated_command"
                          }
                        }
                      }
                    ]
                  }
                ],
                "not": {
                  "any": [
                    {
                      "precedes": {
                        "regex": "^(&&|\\|\\|)$",
                        "precedes": {
                          "command": [
                            "echo",
                            "printf"
                          ],
                          "regex": "^(?:(?:\\S*/)?echo(?:\\s+-[neE]+)*(?:\\s+(?:\\\"(?:\\\\[nt])*\\s*(?:(?:[-=*_~]{2,}|#{1,6})(?:[^\\\"'`\\\\\\n]|\\\\[nt])*)?\\\"|'(?:\\\\[nt])*\\s*(?:(?:[-=*_~]{2,}|#{1,6})(?:[^\\\"'`\\\\\\n]|\\\\[nt])*)?'|(?:[-=*_~]{2,}|#{1,6})(?:[^\\\"'`\\\\\\n]|\\\\[nt])*))?\\s*|(?:\\S*/)?printf(?:\\s+--)?\\s+(?:\\\"(?:\\\\[nt])*\\s*(?:(?:[-=*_~]{2,}|#{1,6})(?:[^\\\"'`\\\\\\n]|\\\\[nt])*)?\\\"|'(?:\\\\[nt])*\\s*(?:(?:[-=*_~]{2,}|#{1,6})(?:[^\\\"'`\\\\\\n]|\\\\[nt])*)?')(?:\\s+(?:[^\\s\\\"'`$\\\\]+|\\\"[^\\\"`$\\\\]*\\\"|'[^']*'))*\\s*)$",
                          "not": {
                            "has": {
                              "any": [
                                {
                                  "kind": "simple_expansion"
                                },
                                {
                                  "kind": "expansion"
                                },
                                {
                                  "kind": "command_substitution"
                                },
                                {
                                  "kind": "arithmetic_expansion"
                                }
                              ],
                              "stopBy": "end"
                            }
                          }
                        }
                      },
                      "not": {
                        "inside": {
                          "kind": "program",
                          "stopBy": "end",
                          "has": {
                            "kind": "special_variable_name",
                            "regex": "^\\?$",
                            "stopBy": "end"
                          }
                        }
                      }
                    },
                    {
                      "precedes": {
                        "regex": "^\\|\\|$",
                        "precedes": {
                          "command": [
                            "true",
                            ":"
                          ],
                          "regex": "^(true|:)$"
                        }
                      }
                    },
                    {
                      "nthChild": {
                        "position": 1,
                        "reverse": true
                      },
                      "inside": {
                        "any": [
                          {
                            "kind": "list"
                          },
                          {
                            "kind": "subshell"
                          },
                          {
                            "kind": "compound_statement"
                          }
                        ],
                        "precedes": {
                          "regex": "^(&&|\\|\\|)$",
                          "precedes": {
                            "command": [
                              "echo",
                              "printf"
                            ],
                            "regex": "^(?:(?:\\S*/)?echo(?:\\s+-[neE]+)*(?:\\s+(?:\\\"(?:\\\\[nt])*\\s*(?:(?:[-=*_~]{2,}|#{1,6})(?:[^\\\"'`\\\\\\n]|\\\\[nt])*)?\\\"|'(?:\\\\[nt])*\\s*(?:(?:[-=*_~]{2,}|#{1,6})(?:[^\\\"'`\\\\\\n]|\\\\[nt])*)?'|(?:[-=*_~]{2,}|#{1,6})(?:[^\\\"'`\\\\\\n]|\\\\[nt])*))?\\s*|(?:\\S*/)?printf(?:\\s+--)?\\s+(?:\\\"(?:\\\\[nt])*\\s*(?:(?:[-=*_~]{2,}|#{1,6})(?:[^\\\"'`\\\\\\n]|\\\\[nt])*)?\\\"|'(?:\\\\[nt])*\\s*(?:(?:[-=*_~]{2,}|#{1,6})(?:[^\\\"'`\\\\\\n]|\\\\[nt])*)?')(?:\\s+(?:[^\\s\\\"'`$\\\\]+|\\\"[^\\\"`$\\\\]*\\\"|'[^']*'))*\\s*)$",
                            "not": {
                              "has": {
                                "any": [
                                  {
                                    "kind": "simple_expansion"
                                  },
                                  {
                                    "kind": "expansion"
                                  },
                                  {
                                    "kind": "command_substitution"
                                  },
                                  {
                                    "kind": "arithmetic_expansion"
                                  }
                                ],
                                "stopBy": "end"
                              }
                            }
                          }
                        }
                      },
                      "not": {
                        "inside": {
                          "kind": "program",
                          "stopBy": "end",
                          "has": {
                            "kind": "special_variable_name",
                            "regex": "^\\?$",
                            "stopBy": "end"
                          }
                        }
                      }
                    },
                    {
                      "nthChild": {
                        "position": 1,
                        "reverse": true
                      },
                      "inside": {
                        "any": [
                          {
                            "kind": "list"
                          },
                          {
                            "kind": "subshell"
                          },
                          {
                            "kind": "compound_statement"
                          }
                        ],
                        "precedes": {
                          "regex": "^\\|\\|$",
                          "precedes": {
                            "command": [
                              "true",
                              ":"
                            ],
                            "regex": "^(true|:)$"
                          }
                        }
                      }
                    },
                    {
                      "follows": {
                        "any": [
                          {
                            "kind": "command",
                            "regex": "^set(\\s+\\S+)*\\s+-[A-Za-z]*o\\s+pipefail(\\s|$)"
                          },
                          {
                            "kind": "command",
                            "regex": "(?i)^setopt(\\s+\\S+)*\\s+pipe_?fail(\\s|$)"
                          }
                        ],
                        "stopBy": "end"
                      }
                    },
                    {
                      "inside": {
                        "follows": {
                          "any": [
                            {
                              "kind": "command",
                              "regex": "^set(\\s+\\S+)*\\s+-[A-Za-z]*o\\s+pipefail(\\s|$)"
                            },
                            {
                              "kind": "command",
                              "regex": "(?i)^setopt(\\s+\\S+)*\\s+pipe_?fail(\\s|$)"
                            }
                          ],
                          "stopBy": "end"
                        },
                        "stopBy": "end"
                      }
                    },
                    {
                      "inside": {
                        "kind": "program",
                        "regex": "PIPESTATUS|pipestatus",
                        "stopBy": "end"
                      }
                    }
                  ]
                }
              }
            }
          ]
        },
        "name": "LAST",
        "field": "name"
      },
      "action": "deny",
      "message": "A pipeline's status is its last command's (`{LAST}`), so a failure of the first command goes unseen. Run `set -o pipefail` first, or write to a file, check the status, then read the file.",
      "messages": [
        {
          "when": {
            "matches": {
              "any": [
                {
                  "inside": {
                    "kind": "pipeline",
                    "precedes": {
                      "has": {
                        "kind": "special_variable_name",
                        "regex": "^\\?$",
                        "stopBy": "end"
                      },
                      "stopBy": "end"
                    }
                  }
                },
                {
                  "inside": {
                    "kind": "pipeline",
                    "inside": {
                      "kind": "redirected_statement",
                      "precedes": {
                        "has": {
                          "kind": "special_variable_name",
                          "regex": "^\\?$",
                          "stopBy": "end"
                        },
                        "stopBy": "end"
                      }
                    }
                  }
                }
              ]
            }
          },
          "text": "`$?` after a pipe is the last command's status. Use `set -o pipefail` first, or read zsh `pipestatus[1]` / bash `PIPESTATUS[0]` in the very next command.",
          "messageShort": "`$?` is the last stage's. `set -o pipefail`, or `pipestatus[1]` (zsh) / `PIPESTATUS[0]` (bash)."
        },
        {
          "when": {
            "matches": {
              "command": "head"
            }
          },
          "text": "`head` hides the producer's status, and `set -o pipefail` would report SIGPIPE (141) when `head` closes early. Write to a file, check the status, then `head` the file.",
          "messageShort": "`head` hides the producer's status; pipefail gives 141. Write to a file, check it, then `head` it."
        }
      ],
      "messageShort": "Pipe status is `{LAST}`'s. `set -o pipefail`, or write to a file and check it."
    },
    "ps-grep-self-match": {
      "description": "ps piped into grep without a self-match guard",
      "match": {
        "command": [
          "grep",
          "egrep",
          "fgrep",
          "rg",
          "awk",
          "sed"
        ],
        "any": [
          {
            "command": [
              "grep",
              "egrep",
              "fgrep",
              "rg"
            ],
            "not": {
              "has": {
                "regex": "^(-[A-Za-z]*v[A-Za-z]*|--invert-match)$"
              }
            }
          },
          {
            "command": "awk",
            "args": "(^|\\s)[\"']/[^/]|\\$0\\s*~"
          },
          {
            "command": "sed",
            "args": "(^|\\s)(-n\\s+)?[\"'](\\d+,)?/[^/]"
          }
        ],
        "inside": {
          "kind": "pipeline",
          "not": {
            "has": {
              "any": [
                {
                  "kind": "command",
                  "regex": "\\[[A-Za-z0-9_.]\\]"
                },
                {
                  "command": [
                    "grep",
                    "egrep",
                    "fgrep",
                    "rg"
                  ],
                  "args": "(^|\\s)(-[A-Za-z]*v[A-Za-z]*|--invert-match)\\s+[^|;&]*(grep|\\brg\\b)"
                }
              ],
              "stopBy": "end"
            }
          }
        },
        "follows": {
          "command": "ps",
          "not": {
            "any": [
              {
                "has": {
                  "regex": "^-[A-Za-z]*p[A-Za-z0-9]*$|^--pid(=.*)?$|^-q$"
                }
              },
              {
                "all": [
                  {
                    "regex": "(^|\\s)-[A-Za-z]*o"
                  },
                  {
                    "not": {
                      "regex": "args|command|cmd"
                    }
                  }
                ]
              }
            ]
          },
          "stopBy": "end"
        }
      },
      "action": "warn",
      "message": "`ps … | grep X` lists the grep itself and your own shell (the tool wraps each command in `zsh -c … eval '…'`, which contains the pattern too), so the output has two false lines.\nAdd `| grep -v grep` AFTER the match, or bracket the pattern (`grep '[c]argo'`: the bracketed pattern does not match its own command line), or use `pgrep -fl PATTERN` as its own command.",
      "messages": [
        {
          "when": {
            "matches": {
              "any": [
                {
                  "has": {
                    "regex": "^-[A-Za-z]*c[A-Za-z]*$"
                  }
                },
                {
                  "inside": {
                    "kind": "pipeline",
                    "has": {
                      "command": "wc",
                      "has": {
                        "regex": "^-[A-Za-z]*l[A-Za-z]*$"
                      }
                    }
                  }
                }
              ]
            }
          },
          "text": "The count is off by about 2: `ps … | grep X` also counts the grep itself and your own shell (the tool wraps each command in `zsh -c … eval '…'`, which contains the pattern too).\nAdd `| grep -v grep` AFTER the match, or bracket the pattern (`grep '[c]argo'`), before counting.",
          "messageShort": "`ps | grep X` also counts the grep itself and your own shell, so a count is off by about 2: `| grep -v grep` after the match, or bracket the pattern (`grep '[c]argo'`)."
        },
        {
          "when": {
            "matches": {
              "inside": {
                "kind": "pipeline",
                "has": {
                  "any": [
                    {
                      "command": "awk",
                      "args": "\\$[12]\\b"
                    },
                    {
                      "command": "cut"
                    }
                  ]
                }
              }
            }
          },
          "text": "The PID you extract may be the grep's or your own shell's, not the process you meant: `ps … | grep X` also lists both (the tool wraps each command in `zsh -c … eval '…'`, which contains the pattern too). Read the output and confirm the PID (`ps -p PID -o command=`) before you use it.\nAdd `| grep -v grep` AFTER the match, or bracket the pattern (`grep '[c]argo'`), so only the real process is left.",
          "messageShort": "The extracted PID may be the grep's or your shell's: confirm it (`ps -p PID -o command=`) before using it; `| grep -v grep` after the match or a bracketed pattern (`grep '[c]argo'`) leaves only the real process."
        }
      ],
      "messageShort": "`ps | grep X` also lists the grep itself and your own shell: `| grep -v grep` after the match, a bracketed pattern (`grep '[c]argo'`), or `pgrep -fl PATTERN` on its own."
    }
  },
  "modes": {},
  "examples": {
    "pipe-status": {
      "catch": [
        "make 2>&1 | tail -5 && echo ok",
        "make | head -20 || echo failed",
        "if make | tail -3; then echo ok; fi",
        "while make | wc -l; do sleep 1; done",
        "! make | tail",
        "cargo build 2>&1 | tail -20; echo \"exit=$?\"",
        "make | tail > out.log && echo ok",
        "set +o pipefail; make | tail && echo ok",
        "git push 2>&1 | tail -3 && echo pushed",
        "bash -c 'make | tail && echo ok'",
        "(make | tail) && echo ok",
        "(make | tail >log) && echo ok",
        "make | tail >/dev/null 2>&1 || echo failed",
        "grep pat f | head && echo found",
        "find . -name x | head && echo ok",
        "make | tail | wc && echo ok",
        "make | sort -u | tee out && echo ok",
        "make 2>&1 | grep err | tail -5 && echo ok",
        "make | tail && echo done",
        "make | tail && echo \"done\"",
        "make | tail && echo \"--- $x ---\"",
        "make | tail && echo \"ok ---\"",
        "make | tail && printf '%s\\n' done",
        "cargo build 2>&1 | tail -3 && echo \"exit=$?\"",
        "git push 2>&1 | tail -2 && git status",
        "make | tail && echo ---; echo $?",
        "make | tail || false",
        "make | tail && git status || true"
      ],
      "pass": [
        "make | tail",
        "set -o pipefail; make | tail && echo ok",
        "set -eo pipefail; if make | tail; then x; fi",
        "setopt pipefail; make | tail && echo ok",
        "make | tail && echo ok; echo ${PIPESTATUS[0]}",
        "make | tail; echo ${pipestatus[1]}",
        "make | grep error && echo found",
        "make | rg error || echo none",
        "make | jq . && echo ok",
        "make | awk '{print $1}' && echo ok",
        "ls | xargs -n1 echo && echo y",
        "make | python3 -c 'x' && echo ok",
        "if x; then make | tail; fi",
        "for f in a b; do make $f | tail -3; done",
        "make | tail; ls",
        "make > out.log && tail out.log",
        "ls | head -3 && echo ---",
        "git log | head -5 && git status",
        "cat f | wc -l && echo done",
        "bash -c 'set -o pipefail; make | tail && echo ok'",
        "make | tail >log; echo done",
        "ls | sort | head && echo ok",
        "git log | sort | head -3 && git status",
        "echo a | tr a b | wc && echo ok",
        "ls | head -3 && echo ---",
        "fd -t f . tests | sort && echo \"=====\"",
        "make | tail && echo \"=====PYPROJECT=====\"",
        "make | tail && echo \"--- listing ---\"",
        "make | tail && echo \"### Section\"",
        "make | tail && echo \"\"",
        "make | tail && echo",
        "make | tail && printf '\\n'",
        "make | tail && printf '=== %s ===\\n' x",
        "make | tail || echo \"---\"",
        "make | tail || true",
        "make | tail || :",
        "make | tail >log || true",
        "a | b | sort || true",
        "(make | tail) && echo ---",
        "x && make | tail || true"
      ]
    },
    "ps-grep-self-match": {
      "catch": [
        "ps aux | grep cargo",
        "ps -ef | grep -i node | wc -l",
        "ps aux | grep vite | awk '{print $2}'",
        "ps aux | rg cargo",
        "ps aux | egrep 'a|b'",
        "ps aux | awk '/cargo/ {print $2}'",
        "ps aux | grep cargo | cut -c1-80",
        "bash -c 'ps aux | grep cargo'",
        "ps -eo pid,command | grep vite",
        "ps aux 2>/dev/null | grep cargo | wc -l"
      ],
      "pass": [
        "ps aux | grep '[c]argo'",
        "ps aux | grep cargo | grep -v grep",
        "ps aux | grep -v grep | grep cargo",
        "ps aux | rg -v rg | rg cargo",
        "ps -p 123 -o comm= | grep node",
        "ps aux | head -5",
        "ps aux | awk '{print $2}'",
        "pgrep -fl cargo",
        "ps aux > ps.txt",
        "echo ps aux | grep x | cat",
        "ps aux | grep -E '[c]argo|[v]ite'",
        "ls | grep x",
        "ps -eo pid,etime,comm | grep cargo",
        "ps aux | awk '$11 ~ /cargo/ {print $2}'",
        "ps aux 2>/dev/null | grep '[c]argo' | wc -l",
        "ps -p 5 | grep x",
        "ps -q 5 | grep x"
      ]
    }
  }
}
