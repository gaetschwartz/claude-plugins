{
  "description": "Mistakes agents repeat with shell pipelines",
  "rules": {
    "pipe-status": {
      "description": "A pipeline ending in a filter whose status is branched on or read as if it were the producer's",
      "match": {
        "capture": {
          "matcher": "preset.unchecked-pipeline-tail",
          "any": [
            {"matcher": "preset.status-gates-or"},
            {"matcher": "preset.status-tests-condition"},
            {"matcher": "preset.status-read-by-next"},
            {"matcher": "preset.status-negated"}
          ]
        },
        "name": "LAST",
        "field": "name"
      },
      "action": "deny",
      "message": "A pipeline's status is its last command's (`{LAST}`), so a failure of the first command goes unseen. Run `set -o pipefail` first, or write to a file, check the status, then read the file.",
      "messages": [
        {
          "when": {"matches": {"matcher": "preset.status-read-by-next"}},
          "text": "`$?` after a pipe is the last command's status. Use `set -o pipefail` first, or read zsh `pipestatus[1]` / bash `PIPESTATUS[0]` in the very next command.",
          "messageShort": "`$?` is the last stage's. `set -o pipefail`, or `pipestatus[1]` (zsh) / `PIPESTATUS[0]` (bash)."
        },
        {
          "when": {"matches": {"command": "head"}},
          "text": "`head` hides the producer's status, and `set -o pipefail` would report SIGPIPE (141) when `head` closes early. Write to a file, check the status, then `head` the file.",
          "messageShort": "`head` hides the producer's status; pipefail gives 141. Write to a file, check it, then `head` it."
        }
      ],
      "messageShort": "Pipe status is `{LAST}`'s. `set -o pipefail`, or write to a file and check it."
    },
    "pipe-status-chain": {
      "description": "A pipeline ending in a filter whose status gates a following `&&`",
      "match": {
        "capture": {"all": [{"matcher": "preset.unchecked-pipeline-tail"}, {"matcher": "preset.status-gates-and"}]},
        "name": "LAST",
        "field": "name"
      },
      "action": "warn",
      "message": "`&&` after this pipeline tests `{LAST}`'s status, so a failure of the first command is masked and the command after `&&` may run anyway. Run `set -o pipefail` first, read `PIPESTATUS`, or run the producer on its own.",
      "messageShort": "`&&` tests `{LAST}`'s status only, so the next command may run after a failure. `set -o pipefail`."
    },
    "ps-grep-self-match": {
      "description": "ps piped into grep without a self-match guard",
      "match": {
        "command": ["grep", "egrep", "fgrep", "rg"],
        "not": {"flag": ["v", "invert-match"]},
        "inside": {
          "kind": "pipeline",
          "not": {
            "has": {
              "any": [
                {"kind": "command", "regex": "\\[[A-Za-z0-9_.]\\]"},
                {"command": ["grep", "egrep", "fgrep", "rg"], "flag": ["v", "invert-match"]}
              ],
              "stopBy": "end"
            }
          }
        },
        "follows": {
          "command": "ps",
          "not": {
            "any": [{"flag": ["p", "pid", "q"]}, {"flag": "o", "not": {"has": {"regex": "args|command|cmd"}}}]
          },
          "stopBy": "end"
        }
      },
      "action": "warn",
      "message": "`ps … | grep X` lists the grep itself and your own shell (the tool wraps each command in `zsh -c … eval '…'`, which contains the pattern too), so the output has two false lines.\nAdd `| grep -v grep` AFTER the match, or bracket the pattern (`grep '[c]argo'`: the bracketed pattern does not match its own command line), or use `pgrep -fl PATTERN` as its own command.",
      "messages": [
        {
          "when": {
            "matches": {
              "any": [{"flag": "c"}, {"inside": {"kind": "pipeline", "has": {"command": "wc", "flag": "l"}}}]
            }
          },
          "text": "The count is off by about 2: `ps … | grep X` also counts the grep itself and your own shell (the tool wraps each command in `zsh -c … eval '…'`, which contains the pattern too).\nAdd `| grep -v grep` AFTER the match, or bracket the pattern (`grep '[c]argo'`), before counting.",
          "messageShort": "`ps | grep X` also counts the grep itself and your own shell, so a count is off by about 2: `| grep -v grep` after the match, or bracket the pattern (`grep '[c]argo'`)."
        },
        {
          "when": {"matches": {"inside": {"kind": "pipeline", "has": {"command": ["awk", "cut"]}}}},
          "text": "The PID you extract may be the grep's or your own shell's, not the process you meant: `ps … | grep X` also lists both (the tool wraps each command in `zsh -c … eval '…'`, which contains the pattern too). Read the output and confirm the PID (`ps -p PID -o command=`) before you use it.\nAdd `| grep -v grep` AFTER the match, or bracket the pattern (`grep '[c]argo'`), so only the real process is left.",
          "messageShort": "The extracted PID may be the grep's or your shell's: confirm it (`ps -p PID -o command=`) before using it; `| grep -v grep` after the match or a bracketed pattern (`grep '[c]argo'`) leaves only the real process."
        }
      ],
      "messageShort": "`ps | grep X` also lists the grep itself and your own shell: `| grep -v grep` after the match, a bracketed pattern (`grep '[c]argo'`), or `pgrep -fl PATTERN` on its own."
    },
    "tail-pipe-buffered": {
      "description": "a stage that buffers its output after tail -f in a Monitor",
      "match": {
        "command": ["cut", "tr", "uniq", "awk", "sed"],
        "not": {
          "any": [{"command": ["sed", "tr"], "flag": ["u", "unbuffered"]}, {"regex": "fflush"}, {"via": "stdbuf"}]
        },
        "inside": {"kind": "pipeline"},
        "follows": {
          "any": [
            {"command": "tail", "flag": ["f", "F", "follow"]},
            {"command": "journalctl", "flag": ["f", "follow"]},
            {"any": [{"pattern": "docker logs $$$"}, {"pattern": "kubectl logs $$$"}], "flag": ["f", "follow"]}
          ],
          "stopBy": "end"
        }
      },
      "when": {
        "tool": "Monitor"
      },
      "action": "warn",
      "message": "A stage after `tail -f` that is not line-buffered holds its output until its buffer fills, so the Monitor stays silent.\nEnd the pipeline with `grep --line-buffered`, or make the stage line-buffered: `sed -u`, `tr -u`, `awk '{{print; fflush()}}'`, `jq --unbuffered`, `stdbuf -oL cut ...`."
    },
    "http-wait-exact-status": {
      "description": "a loop that waits for one specific 2xx status from curl",
      "match": {
        "all": [
          {"any": [{"kind": "while_statement"}, {"kind": "for_statement"}]},
          {"has": {"command": "curl", "stopBy": "end"}},
          {
            "any": [
              {"all": [{"pattern": "until $$$A"}, {"has": {"matcher": "preset.compares-2xx", "stopBy": "end"}}]},
              {
                "all": [
                  {"has": {"command": "break", "stopBy": "end"}},
                  {"has": {"matcher": "preset.compares-2xx", "stopBy": "end"}}
                ]
              },
              {
                "has": {
                  "kind": "case_item",
                  "has": {"nthChild": 1, "matcher": "preset.status-2xx"},
                  "stopBy": "end"
                }
              }
            ]
          }
        ]
      },
      "action": "warn",
      "message": "Do not wait for one specific success code: a 404, 401 or 3xx never becomes 200, so the loop spins until its timeout.\nLoop only while the status is 000 or 5xx, stop on anything else and read the code (`case $c in 000|5??) sleep 2;; *) echo $c; break;; esac`), or let curl retry: `curl --retry N --retry-connrefused -s -o /dev/null -w '%{{http_code}}' URL` (--retry only retries timeouts and HTTP 408, 429, 500, 502, 503, 504)."
    }
  },
  "matchers": {
    "preset.last-child": {"nthChild": {"position": 1, "reverse": true}},
    "preset.status-carrier": {
      "any": [
        {"kind": "pipeline"},
        {"kind": "list"},
        {"kind": "subshell"},
        {"kind": "compound_statement"},
        {"kind": "redirected_statement"}
      ]
    },
    "preset.tail-step": {
      "all": [
        {"matcher": "preset.status-carrier"},
        {"any": [{"matcher": "preset.last-child"}, {"inside": {"kind": "redirected_statement"}}]}
      ]
    },
    "preset.next-statement": {"nthChild": "n", "not": {"kind": "comment"}},
    "preset.pipefail-word": {
      "any": [
        {"pattern": {"context": "\"$a\" pipefail", "selector": "word"}},
        {"pattern": {"context": "\"$a\" pipe_fail", "selector": "word"}}
      ]
    },
    "preset.pipefail-set": {
      "any": [
        {"command": "set", "flag": "o", "has": {"matcher": "preset.pipefail-word"}},
        {"command": "setopt", "has": {"matcher": "preset.pipefail-word"}}
      ]
    },
    "preset.status-checked": {
      "any": [
        {"follows": {"matcher": "preset.pipefail-set", "stopBy": "end"}},
        {"inside": {"follows": {"matcher": "preset.pipefail-set", "stopBy": "end"}, "stopBy": "end"}},
        {
          "inside": {
            "precedes": {"has": {"matcher": "preset.pipestatus-name", "stopBy": "end"}, "stopBy": "end"},
            "stopBy": "end"
          }
        }
      ]
    },
    "preset.pipestatus-name": {
      "any": [
        {"pattern": {"context": "${PIPESTATUS}", "selector": "variable_name"}},
        {"pattern": {"context": "${pipestatus}", "selector": "variable_name"}}
      ]
    },
    "preset.unchecked-pipeline-tail": {
      "command": [
        "head", "tail", "cat", "wc", "sort", "cut", "uniq", "tr", "sed", "tee", "column", "nl", "paste", "rev",
        "fold", "less", "more"
      ],
      "nthChild": {"position": 1, "reverse": true},
      "inside": {"kind": "pipeline"},
      "not": {"matcher": "preset.status-checked"}
    },
    "preset.status-gates-and": {
      "inside": {
        "nthChild": 1,
        "inside": {"pattern": "$A && $B"},
        "stopBy": {"not": {"matcher": "preset.tail-step"}}
      }
    },
    "preset.status-gates-or": {
      "inside": {
        "nthChild": 1,
        "inside": {"pattern": "$A || $B", "not": {"any": [{"pattern": "$A || true"}, {"pattern": "$A || :"}]}},
        "stopBy": {"not": {"matcher": "preset.tail-step"}}
      }
    },
    "preset.status-tests-condition": {
      "inside": {
        "any": [
          {"inside": {"any": [{"kind": "if_statement"}, {"kind": "while_statement"}], "field": "condition"}},
          {"nthChild": 1, "inside": {"kind": "elif_clause"}}
        ],
        "stopBy": {"not": {"matcher": "preset.tail-step"}}
      }
    },
    "preset.status-read-by-next": {
      "inside": {
        "matcher": "preset.status-carrier",
        "nthChild": "n",
        "not": {"any": [{"inside": {"kind": "list"}}, {"precedes": {"regex": "^&$"}}]},
        "precedes": {
          "any": [{"has": {"pattern": "$?", "stopBy": "end"}}, {"has": {"pattern": "${?}", "stopBy": "end"}}],
          "stopBy": {"matcher": "preset.next-statement"}
        },
        "stopBy": {"not": {"matcher": "preset.tail-step"}}
      }
    },
    "preset.status-negated": {"inside": {"kind": "pipeline", "has": {"kind": "negated_command"}}},
    "preset.status-2xx": {"regex": "^\"?2[0-9][0-9]\"?$"},
    "preset.equality": {
      "any": [
        {"pattern": {"context": "[ $A = $B ]", "selector": "binary_expression"}},
        {"pattern": {"context": "[ $A == $B ]", "selector": "binary_expression"}},
        {"pattern": {"context": "[ $A -eq $B ]", "selector": "binary_expression"}}
      ]
    },
    "preset.compares-2xx": {
      "kind": "test_command",
      "has": {"matcher": "preset.equality", "has": {"matcher": "preset.status-2xx"}, "stopBy": "end"}
    }
  },
  "modes": {},
  "examples": {
    "pipe-status": {
      "catch": [
        "make | head -20 || echo failed",
        "if make | tail -3; then echo ok; fi",
        "while make | wc -l; do sleep 1; done",
        "! make | tail",
        "cargo build 2>&1 | tail -20; echo \"exit=$?\"",
        "make | tail >/dev/null 2>&1 || echo failed",
        "set +o pipefail; make | tail || echo failed",
        "bash -c 'make | tail || echo failed'",
        "(make | tail) || echo failed",
        "make | sort -u | tee out || echo failed",
        "make 2>&1 | grep err | tail -5 || exit 1",
        "make | tail || false",
        "(make | tail); echo $?",
        "make | tail\necho $?",
        "{ make | tail; }; echo $?",
        "make | tail; [ $? -eq 0 ] && echo ok",
        "make | tail # note\necho $?",
        "make | tail || git status || true"
      ],
      "pass": [
        "make | tail",
        "set -o pipefail; make | tail || echo failed",
        "set -eo pipefail; if make | tail; then x; fi",
        "setopt pipefail; make | tail || echo failed",
        "make | tail || echo failed; echo ${PIPESTATUS[0]}",
        "make | tail; echo ${pipestatus[1]}",
        "make | grep error || echo none",
        "make | rg error || echo none",
        "make | jq . || echo bad",
        "make | awk '{print $1}' || echo bad",
        "ls | xargs -n1 echo || echo y",
        "if x; then make | tail; fi",
        "for f in a b; do make $f | tail -3; done",
        "make | tail; ls",
        "make > out.log || tail out.log",
        "make | tail || true",
        "make | tail || :",
        "make | tail >log || true",
        "a | b | sort || true",
        "x && make | tail || true",
        "make | tail; echo x; echo $?",
        "make | tail; true; echo $?",
        "just test > log; echo \"exit=$?\"",
        "make > out.log 2>&1; echo \"rc=$?\"",
        "make | tail && echo ok",
        "make | tail; echo x",
        "make | tail & echo $?"
      ]
    },
    "pipe-status-chain": {
      "catch": [
        "make 2>&1 | tail -5 && echo ok",
        "make | tail && ls",
        "make | tail > out.log && echo ok",
        "(make | tail) && echo ok",
        "{ make | tail; } && ls",
        "x && make | tail && git status",
        "make | tail | wc && echo ok",
        "make | sort -u | tee out && echo ok",
        "make 2>&1 | grep err | tail -5 && echo ok",
        "cd x && make | tail && ls",
        "ls | head -3 && echo ---",
        "bash -c 'make | tail && echo ok'",
        "set +o pipefail; make | tail && echo ok",
        "make | tail && sudo ls",
        "make | tail && timeout 300 cargo test",
        "echo ${PIPESTATUS[0]}; make | tail && ls",
        "make | tail && git push",
        "make | tail && ./target/debug/x4c",
        "make | tail && bash script.sh",
        "make | tail && python3 x.py",
        "make | tail && cargo publish",
        "make | tail && timeout 5 git push",
        "make | tail && rm -rf build"
      ],
      "pass": [
        "make | tail",
        "set -o pipefail; make | tail && echo ok",
        "setopt pipefail; make | tail && echo ok",
        "make | tail && echo ok; echo ${PIPESTATUS[0]}",
        "make | grep error && echo found",
        "make | rg error && echo found",
        "make | jq . && echo ok",
        "make | awk '{print $1}' && echo ok",
        "ls | xargs -n1 echo && echo y",
        "make | python3 -c 'x' && echo ok",
        "if x; then make | tail; fi",
        "for f in a b; do make $f | tail -3; done",
        "make | tail; ls",
        "make > out.log && tail out.log",
        "make | tail || echo failed",
        "make | tail || true",
        "make | tail; echo $?",
        "if make | tail; then ls; fi",
        "make | tail; git push",
        "make && git push"
      ]
    },
    "ps-grep-self-match": {
      "catch": [
        "ps aux | grep cargo",
        "ps -ef | grep -i node | wc -l",
        "ps aux | grep vite | awk '{print $2}'",
        "ps aux | rg cargo",
        "ps aux | egrep 'a|b'",
        "ps aux | grep cargo | cut -c1-80",
        "bash -c 'ps aux | grep cargo'",
        "ps -eo pid,command | grep vite",
        "ps aux 2>/dev/null | grep cargo | wc -l"
      ],
      "pass": [
        "ps aux | grep '[c]argo'",
        "ps aux | grep cargo | grep -v grep",
        "ps aux | grep -v grep | grep cargo",
        "ps aux | rg -v rg | rg cargo",
        "ps -p 123 -o comm= | grep node",
        "ps aux | head -5",
        "ps aux | awk '{print $2}'",
        "pgrep -fl cargo",
        "ps aux > ps.txt",
        "echo ps aux | grep x | cat",
        "ps aux | grep -E '[c]argo|[v]ite'",
        "ls | grep x",
        "ps -eo pid,etime,comm | grep cargo",
        "ps aux | awk '$11 ~ /cargo/ {print $2}'",
        "ps aux 2>/dev/null | grep '[c]argo' | wc -l",
        "ps -p 5 | grep x",
        "ps -q 5 | grep x"
      ]
    },
    "tail-pipe-buffered": {
      "catch": [
        "tail -n0 -F log | grep -E --line-buffered 'x|y' | cut -c1-220",
        "tail -f log | sed 's/a/b/'",
        "tail --follow=name log | awk '{print $1}'",
        "journalctl -fu app | cut -c1-80",
        "docker logs -f app | tr a b",
        "kubectl logs --follow pod | uniq",
        "sudo tail -f log | sed 's/a/b/'",
        "tail -f log | uniq -u"
      ],
      "pass": [
        "tail -f log | sed -u 's/a/b/'",
        "tail -f log | tr -u a b",
        "tail -f log | grep --line-buffered x",
        "tail -f log | awk '{print; fflush()}'",
        "tail -f log | stdbuf -oL cut -c1-80",
        "tail -n 20 log | cut -c1-80",
        "cut -d: -f1 f | sort",
        "docker logs app | cut -c1-80",
        "tail -F x | head -3"
      ]
    },
    "http-wait-exact-status": {
      "catch": [
        "for i in $(seq 1 60); do c=$(curl -s -o /dev/null -w \"%{http_code}\" URL); [ \"$c\" = 200 ] && break; sleep 5; done",
        "until [ \"$(curl -s -o /dev/null -w %{http_code} URL)\" = 200 ]; do sleep 5; done",
        "while :; do c=$(curl -s -w %{http_code} URL); case $c in 200) break;; esac; sleep 2; done",
        "until [[ $(curl -s -o /dev/null -w '%{http_code}' URL) == 204 ]]; do sleep 1; done",
        "until [ \"$(curl -s -o /dev/null -w %{http_code} URL)\" -eq 200 ]; do sleep 5; done"
      ],
      "pass": [
        "while :; do c=$(curl -s -o /dev/null -w '%{http_code}' URL); case $c in 000|5??) sleep 2;; *) echo $c; break;; esac; done",
        "while [ \"$(curl -s -o /dev/null -w '%{http_code}' URL)\" -ne 503 ]; do sleep 1; done",
        "for i in 1 2 3; do curl -s URL; done",
        "curl -s URL",
        "curl --retry 5 --retry-connrefused -s -o /dev/null -w '%{http_code}' URL",
        "while [ \"$(curl -s -o /dev/null -w '%{http_code}' URL)\" -eq 200 ]; do sleep 1; done",
        "until [ \"$(curl -s -o /dev/null -w %{http_code} URL)\" != 200 ]; do sleep 5; done",
        "until [ \"$(curl -s -o /dev/null -w %{http_code} URL)\" -ne 200 ]; do sleep 5; done",
        "until [ \"$(curl -s -o /dev/null -w %{http_code} URL)\" -ge 500 ]; do sleep 5; done"
      ]
    }
  }
}
