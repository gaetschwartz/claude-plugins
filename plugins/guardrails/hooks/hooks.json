{
  "description": "guardrails: data-driven deny/warn rules for Bash commands (rules live in state; nothing is active until presets are installed)",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/guardrails.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/guardrails.sh\" session-start",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
