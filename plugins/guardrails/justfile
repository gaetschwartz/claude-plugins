pin := `python3 -c "import json; print(json.load(open('lib/runtime-manifest.json'))['astGrepPy'])"`
run := "uv run --no-project --python 3.13 --with ast-grep-py==" + pin

# Run the suite on the pinned library; tests that run the real hook install the runtime into a cache once and skip when offline
test:
    {{run}} python -m unittest discover -s tests

# The bootstrap is the one module that must run on the host's own Python: run its tests on macOS's 3.9
test-39:
    /usr/bin/python3 -m unittest discover -s tests -p test_bootstrap.py

# CI: a runtime that cannot be installed fails the tests instead of skipping them
ci:
    GUARDRAILS_REQUIRE_AST=1 {{run}} python -m unittest discover -s tests

# Rewrite lib/runtime-manifest.json, runtime-requirements.txt and runtime-id after bumping the pins in the script
manifest:
    python3 scripts/gen-runtime-manifest.py

# Lint + type-check
check:
    uvx ruff check .
    uv run --no-project --python 3.13 --with ast-grep-py=={{pin}} --with ty sh -c 'ty check --extra-search-path lib --extra-search-path "$(python -c "import ast_grep_py, pathlib; print(pathlib.Path(ast_grep_py.__file__).parent.parent)")" .'

# Validate the plugin manifest and skill frontmatter with Claude Code
validate:
    claude plugin validate .
    claude plugin validate skills
