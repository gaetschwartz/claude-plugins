# Install the pinned ast-grep binary (the wheel path) into the dev cache the tests use; skipped quietly when offline
engine:
    -CLAUDE_PLUGIN_DATA="$HOME/.cache/guardrails-engine-dev" python3 lib/guard.py engine install

# Run the test suite (the tests that need ast-grep skip with a message when it cannot be installed)
test: engine
    python3 -m unittest discover -s tests -v

# Run the suite under macOS's /usr/bin/python3 (3.9), the oldest supported interpreter
test-39: engine
    /usr/bin/python3 -m unittest discover -s tests

# CI: install the engine (a failure fails the job) and make a missing engine a test failure instead of skips
ci:
    CLAUDE_PLUGIN_DATA="$HOME/.cache/guardrails-engine-dev" python3 lib/guard.py engine install
    GUARDRAILS_REQUIRE_AST=1 python3 -m unittest discover -s tests

# Rewrite lib/engine-manifest.json after bumping the pin in package.json and regenerating package-lock.json
manifest:
    python3 scripts/gen-engine-manifest.py

# Lint + type-check (ty needs the lib dir on its search path)
check:
    uvx ruff check .
    uvx ty check --extra-search-path lib .

# Validate the plugin manifest and skill frontmatter with Claude Code
validate:
    claude plugin validate .
    claude plugin validate skills
