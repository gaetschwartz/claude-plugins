# Run the test suite; the AST tests need ast-grep-py, which uv supplies (they skip with a message without it)
test:
    uv run --quiet --no-project --with ast-grep-py==0.45.3 python -m unittest discover -s tests -v

# Run the suite without uv: the tests that need ast-grep-py skip
test-plain:
    python3 -m unittest discover -s tests -v

# Compare the stdlib matcher with the ast-compiled one (see README, Matcher parity)
parity:
    uv run --quiet --no-project --with ast-grep-py==0.45.3 python tests/parity_study.py

# Lint + type-check (ty needs the lib dir on its search path)
check:
    uvx ruff check .
    uvx ty check --extra-search-path lib .

# Validate the plugin manifest and skill frontmatter with Claude Code
validate:
    claude plugin validate .
    claude plugin validate skills
